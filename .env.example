AGENT_SETTINGS_SOCKET=/run/free-bbs/agent-config.sock
AGENT_SERVICE_TOKEN=replace-with-at-least-32-random-characters
AGENT_SETTINGS_TIMEOUT_SECONDS=2
AGENT_SETTINGS_CACHE_TTL_SECONDS=30
AGENT_SETTINGS_STALE_TTL_SECONDS=300
COURSE_MATERIALS_ROOT=
AGENT_HOST=127.0.0.1
AGENT_PORT=5001
AGENT_TIMEOUT_SECONDS=60
AGENT_SYSTEM_PROMPT=你是 FREE-BBS 的 AI 助手，服务于一个学习和交流社区。请用简洁、准确、友好的中文回答用户问题。优先给出可执行的步骤、清晰的解释和必要的示例。如果问题信息不足，请先说明需要哪些信息；如果不确定，请明确标注不确定性。不要编造事实、链接、接口或项目细节。
NAVIGATION_LLM_ENABLED=true
# 留空则使用 AGENT_MODEL；也可为导引 Agent 单独指定更快的模型
NAVIGATION_MODEL=
# 规则置信度达到此值时直接路由，不调用 LLM
NAVIGATION_LLM_CONFIDENCE_THRESHOLD=0.7
# Local freebbs-web frontend; replace with https://www.free-bbs.cn in production.
FREEBBS_WEB_BASE_URL=http://127.0.0.1:3000

# Info Sub-Agent bridge. The two token values are server-side secrets and must
# never be sent to the browser.
INFO_AGENT_ENABLED=false
INFO_AGENT_BASE_URL=http://127.0.0.1:4310
INFO_AGENT_INTERNAL_TOKEN=
INFO_AGENT_TIMEOUT_SECONDS=30
INFO_AGENT_AUTO_AUTHENTICATE=true
FREEBBS_AGENT_INTERNAL_TOKEN=

RAG_ENABLED=false
RAG_INDEX_PATH=data/rag/index.faiss
RAG_METADATA_PATH=data/rag/metadata.jsonl
RAG_INDEX_MANIFEST_PATH=data/rag/current.json
RAG_INDEX_RELOAD_INTERVAL_SECONDS=5
RAG_COURSE_SNAPSHOT_ENDPOINT=/internal/v1/rag-course-snapshot
# 本地可单独配置这两个变量，避免启用 Web 托管的模型设置。
RAG_COURSE_SNAPSHOT_SOCKET=
RAG_COURSE_SNAPSHOT_TOKEN=
RAG_SYNC_TIMEOUT_SECONDS=30
RAG_VERSION_RETENTION=3
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHUNKS=4
RAG_EMBEDDING_PROVIDER=local
RAG_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_LOCAL_EMBEDDING_DIM=512
RAG_LOCAL_MODEL_DIR=data/models/bge-small-zh-v1.5
RAG_LOCAL_FILES_ONLY=true
RAG_HF_ENDPOINT=https://hf-mirror.com
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=text-embedding-3-small
ONLINE_ROUTER_ENABLED=true
ONLINE_ROUTER_CONFIDENCE_THRESHOLD=0.7
RAG_QUERY_AUGMENTATION_ENABLED=true
RAG_MAX_SUBQUERIES=3
